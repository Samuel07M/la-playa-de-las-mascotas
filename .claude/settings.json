{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx vitest *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh issue view *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(git switch *)",
      "Bash(git checkout *)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo sync *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)"
    ]
  }
}
