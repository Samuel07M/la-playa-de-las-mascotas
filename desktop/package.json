{
  "name": "la-playa-de-las-mascotas",
  "productName": "La Playa de las Mascotas",
  "version": "1.0.0",
  "description": "Inventario y ventas de La Playa de las Mascotas",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/electron-node.mjs vitest run",
    "seed": "electron-vite build && node scripts/electron-node.mjs out/main/seed.js",
    "build:win": "electron-vite build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "42.11.18",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "electron-winstaller": false
  }
}
